---
interface Props {
  title: string;
  description: string;
  tags: string[];
  metrics?: { label: string; value?: string; before?: string; after?: string }[];
  featured?: boolean;
  slug: string;
  githubUrl?: string;
}
const { title, description, tags, metrics, featured, slug, githubUrl } = Astro.props;
---
<article class="group relative bg-dark-card dark:bg-dark-card light:bg-light-card rounded-2xl border border-dark-border dark:border-dark-border light:border-light-border p-6 md:p-8 transition-all duration-300 hover:border-primary/50 hover:shadow-xl hover:shadow-primary/10 flex flex-col h-full">
  {featured && (
    <div class="absolute -top-3 -right-3 bg-accent text-white text-xs font-mono px-2 py-0.5 rounded">Featured</div>
  )}

  <div class="flex items-start justify-between gap-4 mb-4">
    <h3 class="text-xl font-bold text-slate-100 dark:text-slate-100 light:text-slate-900 group-hover:text-primary transition-colors flex-1 pr-4">
      <a href={`/projects/${slug}/`}>{title}</a>
    </h3>
    {githubUrl && (
      <a href={githubUrl} target="_blank" rel="noopener" class="text-slate-500 hover:text-primary transition-colors opacity-0 group-hover:opacity-100 p-2 rounded-lg hover:bg-primary/10">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
      </a>
    )}
  </div>

  <p class="text-slate-400 dark:text-slate-400 light:text-slate-600 text-sm md:text-base mb-5 flex-1 leading-relaxed">{description}</p>

  {/* Metrics */}
  {metrics && metrics.length > 0 && (
    <div class="grid grid-cols-2 gap-3 mb-4 p-3 bg-dark-bg/50 dark:bg-dark-bg/50 light:bg-light-bg/50 rounded-lg border border-dark-border/50">
      {metrics.map((m, i) => (
        <div key={i} class="text-center">
          <p class="text-xs font-mono text-accent dark:text-accent light:text-accent">{m.value || m.after || '✓'}</p>
          <p class="text-[10px] text-slate-500 uppercase tracking-wider">{m.label}</p>
          {m.before && <p class="text-[9px] text-slate-600 line-through">was {m.before}</p>}
        </div>
      ))}
    </div>
  )}

  {/* Tags */}
  <div class="flex flex-wrap gap-1.5 mt-auto pt-4 border-t border-dark-border/50">
    {tags.slice(0, 5).map(tag => (
      <span key={tag} class="px-2 py-0.5 text-xs font-mono rounded bg-dark-bg dark:bg-dark-bg light:bg-light-bg border border-dark-border/50 text-slate-500">{tag}</span>
    ))}
    {tags.length > 5 && <span class="px-2 py-0.5 text-xs font-mono rounded bg-primary/10 text-primary border border-primary/20">+{tags.length - 5}</span>}
  </div>
</article>