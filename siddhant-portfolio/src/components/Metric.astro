---
interface Props {
  label: string;
  value: string;
}

const { label, value } = Astro.props;
---
<div class="bg-dark-card/50 dark:bg-dark-card/50 light:bg-light-card/50 backdrop-blur-sm rounded-xl border border-dark-border/50 dark:border-dark-border/50 light:border-light-border/50 p-4">
  <p class="text-3xl md:text-4xl font-bold font-mono text-primary dark:text-primary light:text-primary-dark">{value}</p>
  <p class="text-xs md:text-sm text-slate-500 dark:text-slate-400 light:text-slate-500 uppercase tracking-wider">{label}</p>
</div>